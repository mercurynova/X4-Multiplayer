<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The launcher's decision logic: scanning game folders, reading content.xml and planning mod toggles. No WPF and no
    Windows-only API, so it builds and tests everywhere. X4MP.Protocol is referenced for the shared mod-policy
    constants and link rules (docs/mod-management.md 2 and 3.6): the launcher must classify a mod the same way the
    server and the game do, and one copy of the allowlist is the only way to guarantee that.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\server\src\X4MP.Protocol\X4MP.Protocol.csproj" />
  </ItemGroup>

</Project>
