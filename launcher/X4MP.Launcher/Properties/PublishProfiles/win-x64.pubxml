<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- dotnet publish launcher/X4MP.Launcher -c Release -p:PublishProfile=win-x64
       The launcher ships inside the mod zip, so it has to run on a player's machine without a .NET
       install: single-file, self-contained, compressed. R2R is off on purpose - it is a GUI that
       starts once and then waits, and the extra image would only grow the download. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\out\launcher-win-x64\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
