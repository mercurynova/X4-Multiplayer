<Window x:Class="X4MP.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X4MP launcher" Height="640" Width="1020" WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="X4MP launcher" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0" Foreground="#555555" TextWrapping="Wrap"
                       Text="Checks what this server runs and what your game is missing. Nothing is downloaded. Checking writes no file; Apply changes only your profile's content.xml, and the launcher restores it when X4 exits." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Server" />
            <TextBox x:Name="ServerBox" Grid.Column="1" Margin="8,0,16,0" Padding="6,4" Text="http://localhost:47790" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Join password" />
            <PasswordBox x:Name="PasswordBox" Grid.Column="3" Margin="8,0,16,0" Padding="6,4" />
            <Button x:Name="CheckButton" Grid.Column="4" Padding="20,5" Content="Check" Click="OnCheck" />
            <TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center" Text="Your name in game" />
            <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Margin="8,10,16,0" Padding="6,4" />
            <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,10,0,0" VerticalAlignment="Center"
                       Foreground="#555555" TextWrapping="Wrap"
                       Text="The name other players see. Start X4 writes the join request the mod reads once at startup." />
            <CheckBox x:Name="HostCheckBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Margin="8,10,16,0"
                      VerticalAlignment="Center" Checked="OnHostChanged" Unchecked="OnHostChanged"
                      Content="Host this session on this PC (starts the local server before X4)" />
        </Grid>

        <TextBlock x:Name="SessionBlock" Grid.Row="2" Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />

        <TextBlock x:Name="StatusBlock" Grid.Row="3" Margin="0,6,0,10" TextWrapping="Wrap"
                   Text="Enter the address the server showed you, then press Check." />

        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ApplyButton" Padding="16,5" Content="Apply this plan" Click="OnApply" IsEnabled="False" />
                <Button x:Name="RestoreButton" Padding="16,5" Margin="8,0,0,0" Content="Restore my original mods"
                        Click="OnRestore" IsEnabled="False" />
                <CheckBox x:Name="KeepCheckBox" Margin="20,0,0,0" VerticalAlignment="Center"
                          Content="Keep this mod set after I quit X4" />
                <Button x:Name="StartButton" Padding="16,5" Margin="20,0,0,0" Content="Start X4"
                        Click="OnStart" IsEnabled="False"
                        ToolTip="Writes the join request and asks Steam to start the game. Apply the plan first if there is one." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock VerticalAlignment="Center" Foreground="#555555" Text="Missing a mod? Select its row, open the page, subscribe, then:" />
                <Button x:Name="CheckAgainButton" Padding="16,5" Margin="12,0,0,0" Content="Check again" Click="OnCheck" />
                <Button x:Name="WorkshopButton" Padding="16,5" Margin="8,0,0,0" Content="Open Workshop page"
                        Click="OnOpenWorkshop" IsEnabled="False" />
                <Button x:Name="NexusButton" Padding="16,5" Margin="8,0,0,0" Content="Open Nexus page"
                        Click="OnOpenNexus" IsEnabled="False" />
            </StackPanel>
        </StackPanel>

        <ListView x:Name="PlanList" Grid.Row="5" SelectionChanged="OnPlanSelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Action" Width="80" DisplayMemberBinding="{Binding ActionText}" />
                    <GridViewColumn Header="Mod" Width="320" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Class" Width="90" DisplayMemberBinding="{Binding Class}" />
                    <GridViewColumn Header="Rule" Width="80" DisplayMemberBinding="{Binding Rule}" />
                    <GridViewColumn Header="Version" Width="140" DisplayMemberBinding="{Binding VersionText}" />
                    <GridViewColumn Header="Notes" Width="260" DisplayMemberBinding="{Binding Notes}" />
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="6" Margin="0,10,0,0" Foreground="#666666" TextWrapping="Wrap"
                   Text="Apply writes the profile's content.xml and keeps a backup in x4mp\profile-backups. X4 must be closed. If the launcher is closed while X4 runs, the next start restores your mods. Start X4 writes one join request for the mod to read at startup and deletes it once it is read; the launcher opens only Steam Workshop, Nexus Mods and the game's own Steam page, and only when you press a button. Host mode runs the server beside the launcher, stops it when X4 exits, and uses TCP 47780, UDP 47781 and TCP 47790 on this PC." />
    </Grid>
</Window>
