<?xml version="1.0" encoding="UTF-8"?>
<!-- Addon registration, same structure as vanilla ui/addons/*/ui.xml (e.g. ego_chatwindow). Needs Settings > Extensions >
     Protected UI mode OFF (X4Native requires it too).
     LOAD ORDER MATTERS: bridge first (global X4MPBridge), then the screens (X4MPScreens), then renderers and the rest.
     Owners (M2 plan, shared-file rules): x4mp_bridge.lua, x4mp_menu.lua, x4mp_ui_standalone.lua, x4mp_extensions.lua = M2-05
     (x4mp_bridge.lua and x4mp_menu.lua are then edited by M2-06 only; M2-09 and M2-X3 add to x4mp_menu.lua after it).
     STUBS filled later by their own task: x4mp_saves.lua (M2-10), x4mp_optionsmenu_adapter.lua and x4mp_hud.lua (M2-11),
     x4mp_join_mods.lua (M2-X3). M3-06 added x4mp_players.lua (player table, join/leave) and x4mp_chat.lua (vanilla chat window adapter).
     M3-08 added x4mp_teams.lua (carries the team faction plan to md/x4mp_teams.xml and the answer back).
     M3-11 added x4mp_avatars.lua (carries the avatar safe-position / dress / velocity requests to md/x4mp_avatars.xml and the answers back).
     M3-10 added x4mp_ghosts.lua (Lua half of the client ghosts: MD dress and velocity hint; the one line below is all it took).
     M3b added x4mp_onfoot.lua (the room report MD pushes to native; native does the rest).
     M3-23 added x4mp_diag.lua (the knowledge probe, Finding 4).
     M4-03 added x4mp_capture.lua (the authority's sector scan: MD lists the ship ids of a sector, native indexes them).
     M4-18 added x4mp_statics.lua (the client's station scan: MD lists a sector's stations with their positions, native matches them to
     the checkpoint manifest).
     M5-01 added x4mp_events.lua (the Lua half of the event capture ring: one line per occurrence from md/x4mp_events.xml to native).
     M5-15 added x4mp_actions.lua (the economy actions shim: native's queued cargo and money changes become one AddUITriggeredEvent per
     frame, md/x4mp_actions.xml applies them with add_cargo/remove_cargo exact= and transfer_money).
     M5-22 added x4mp_money.lua (the wallet read: GetPlayerMoney() polled per frame, pushed to native as x4mp.money only on change;
     native has no money getter of its own).
     M5-29/30 added x4mp_economy.lua (the economy screen and the /mp commands: loans and trades from topic x4mp.economy, every
     action sent as verb x4mp.economy; it needs x4mp_chat.lua for the system lines, so it loads after it).
     M5-32 added x4mp_server.lua (the dedicated server screen and the /mp server commands: it starts and stops the server the
     extension ships; it loads after x4mp_economy.lua because the chat adapter gives every /mp line to the economy module first).
     Later tasks must not edit this file.
     __X4MP_USER (userdata storage, not in the save): { version, lastAddress, lastName }; never the password. -->
<addon name="x4mp">
  <environment type="menus">
    <file name="ui/x4mp_bridge.lua" />
    <file name="ui/x4mp_menu.lua" />
    <file name="ui/x4mp_ui_standalone.lua" />
    <file name="ui/x4mp_extensions.lua" />
    <file name="ui/x4mp_saves.lua" />
    <file name="ui/x4mp_authority.lua" />
    <file name="ui/x4mp_capture.lua" />
    <file name="ui/x4mp_statics.lua" />
    <file name="ui/x4mp_actions.lua" />
  <file name="ui/x4mp_damage.lua" />
    <file name="ui/x4mp_optionsmenu_adapter.lua" />
    <file name="ui/x4mp_hud.lua" />
    <file name="ui/x4mp_join_mods.lua" />
    <file name="ui/x4mp_players.lua" />
    <file name="ui/x4mp_chat.lua" />
    <file name="ui/x4mp_teams.lua" />
    <file name="ui/x4mp_avatars.lua" />
    <file name="ui/x4mp_ghosts.lua" />
    <file name="ui/x4mp_onfoot.lua" />
    <file name="ui/x4mp_diag.lua" />
    <file name="ui/x4mp_events.lua" />
    <file name="ui/x4mp_money.lua" />
    <file name="ui/x4mp_economy.lua" />
    <file name="ui/x4mp_server.lua" />
    <file name="ui/x4mp_map.lua" />
    <dependency name="ego_detailmonitorHelper" />
    <savedvariable name="__X4MP_USER" storage="userdata" />
  </environment>
</addon>
