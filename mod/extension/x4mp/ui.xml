<?xml version="1.0" encoding="UTF-8"?>
<!-- Addon registration, same structure as vanilla ui/addons/*/ui.xml (e.g. ego_chatwindow). Needs Settings > Extensions >
     Protected UI mode OFF (X4Native requires it too).
     LOAD ORDER MATTERS: bridge first (global X4MPBridge), then the screens (X4MPScreens), then renderers and the rest.
     Owners (M2 plan, shared-file rules): x4mp_bridge.lua, x4mp_menu.lua, x4mp_ui_standalone.lua, x4mp_extensions.lua = M2-05
     (x4mp_bridge.lua and x4mp_menu.lua are then edited by M2-06 only; M2-09 and M2-X3 add to x4mp_menu.lua after it).
     STUBS filled later by their own task: x4mp_saves.lua (M2-10), x4mp_optionsmenu_adapter.lua and x4mp_hud.lua (M2-11),
     x4mp_join_mods.lua (M2-X3). Later tasks must not edit this file.
     __X4MP_USER (userdata storage, not in the save): { version, lastAddress, lastName }; never the password. -->
<addon name="x4mp">
  <environment type="menus">
    <file name="ui/x4mp_bridge.lua" />
    <file name="ui/x4mp_menu.lua" />
    <file name="ui/x4mp_ui_standalone.lua" />
    <file name="ui/x4mp_extensions.lua" />
    <file name="ui/x4mp_saves.lua" />
    <file name="ui/x4mp_optionsmenu_adapter.lua" />
    <file name="ui/x4mp_hud.lua" />
    <file name="ui/x4mp_join_mods.lua" />
    <dependency name="ego_detailmonitorHelper" />
    <savedvariable name="__X4MP_USER" storage="userdata" />
  </environment>
</addon>
