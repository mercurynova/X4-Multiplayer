<?xml version="1.0" encoding="utf-8"?>
<!--
  X4MP diagnostics, MD side (M3-23, Finding 4: the client loses the player's map knowledge). Lua side: ui/x4mp_diag.lua;
  native side: features/diag/knowledge_feature.* (the log line "knowledge: sectors_known=N/M ...").

  Lua -> MD  AddUITriggeredEvent("X4MP_Diag", "probe", <seq>)   count what the player knows (event.param3 = the sequence number, echoed)
  MD -> Lua  raise_lua_event 'x4mp.md_knowledge' <string>, forwarded unchanged to native (verb x4mp.knowledge_md):
               K;<seq>;<age>;<sectors_known>;<sectors>;<clusters_known>;<clusters>;<stations_known>;<stations>;<gates_known>;<gates>;<sample>=<1|0|->,...
             age = player.age (the game clock, seconds), so a line can be placed among the neighbouring log lines;
             sample: 1 = the sector is known to the player, 0 = unknown, - = the sector was not found.

  What counts as "known to the player" (X4 9.00 script data, x4-unpacked):
    sectors / stations / gates  find_sector / find_station / find_gate over the whole galaxy, once plain and once with the search attribute
                                known="true" ("Known to player?", libraries/common.xsd:5709) or knownto="faction.player" (the attribute md/cinematiccamera.xml:183
                                and md/rml_map_space.xml:58 use for sectors / zones)
    clusters, samples           the property .isknown ("true iff the component is known to the player", libraries/scriptproperties.xml:89), as md/diplomacy.xml:7218 and
                                md/setup.xml:891 use it on a cluster / sector
  find_station with space="player.galaxy" and multiple="true" is the pattern of md/conversations.xml:495.

  Read-only: nothing here changes the game.
-->
<mdscript name="X4MP_Diag" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>

    <cue name="X4MP_Diag_Probe" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'X4MP_Diag'" control="'probe'"/>
      </conditions>
      <actions>
        <set_value name="$Seq" exact="event.param3"/>

        <find_sector name="$AllSectors" multiple="true"/>
        <find_sector name="$KnownSectors" multiple="true" knownto="faction.player"/>

        <find_cluster name="$AllClusters" multiple="true"/>
        <set_value name="$KnownClusterCount" exact="0"/>
        <do_for_each name="$Cl" in="$AllClusters">
          <do_if value="$Cl.isknown">
            <set_value name="$KnownClusterCount" exact="$KnownClusterCount + 1"/>
          </do_if>
        </do_for_each>

        <find_station name="$AllStations" space="player.galaxy" multiple="true"/>
        <find_station name="$KnownStations" space="player.galaxy" multiple="true" known="true"/>

        <find_gate name="$AllGates" space="player.galaxy" multiple="true"/>
        <find_gate name="$KnownGates" space="player.galaxy" multiple="true" known="true"/>

        <!-- three named sample sectors: Grand Exchange I (the game start of the mod's test saves), cluster 07, cluster 14 -->
        <set_value name="$Samples" exact="''"/>
        <find_sector name="$Sample1" macro="macro.cluster_01_sector001_macro"/>
        <do_if value="@$Sample1.exists">
          <set_value name="$Samples" exact="'01_001=' + (if $Sample1.isknown then 1 else 0)"/>
        </do_if>
        <do_else>
          <set_value name="$Samples" exact="'01_001=-'"/>
        </do_else>
        <find_sector name="$Sample2" macro="macro.cluster_07_sector001_macro"/>
        <do_if value="@$Sample2.exists">
          <set_value name="$Samples" exact="$Samples + ',07_001=' + (if $Sample2.isknown then 1 else 0)"/>
        </do_if>
        <do_else>
          <set_value name="$Samples" exact="$Samples + ',07_001=-'"/>
        </do_else>
        <find_sector name="$Sample3" macro="macro.cluster_14_sector001_macro"/>
        <do_if value="@$Sample3.exists">
          <set_value name="$Samples" exact="$Samples + ',14_001=' + (if $Sample3.isknown then 1 else 0)"/>
        </do_if>
        <do_else>
          <set_value name="$Samples" exact="$Samples + ',14_001=-'"/>
        </do_else>

        <raise_lua_event name="'x4mp.md_knowledge'"
                         param="'K;' + $Seq + ';' + player.age + ';' + $KnownSectors.count + ';' + $AllSectors.count + ';' + $KnownClusterCount + ';' + $AllClusters.count + ';' + $KnownStations.count + ';' + $AllStations.count + ';' + $KnownGates.count + ';' + $AllGates.count + ';' + $Samples"/>
      </actions>
    </cue>

    <!-- M3-28: the live-view watch (`/x4mp knowledge watch`, native features/diag/knowledge_feature.* kWatch*). Read-only.
         Lua -> MD  AddUITriggeredEvent("X4MP_Diag", "watch", { seq, max })
         MD -> Lua  'x4mp.md_knowledge' (same path as above):
           W;<seq>;<age>;<player sector macro|->;<player ship idcode|->;<undiscovered|none|->;<team ships total>|<ship>|<ship>...
           <ship> = <idcode>,<owner id>,<relation to player>,<radar>,<liveview>,<gravidar>,<active>,<known>,<sector macro|->  (flags 1 / 0)
         Properties (libraries/scriptproperties.xml): isradarvisible :222, isinliveview :193, isgravidarplayeraccessible :289, isactive :144, isknown :89,
         relationto.{faction} :94 / :1845, idcode :198, owner :71, sector :40. find_ship ... owner= space="player.galaxy" multiple: md/factionlogic.xml:1020.
         find_closest_undiscovered_position (libraries/common.xsd:27045, null = nothing undiscovered within range): the position of the player's ship, 2 km. -->
    <cue name="X4MP_Diag_Watch" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'X4MP_Diag'" control="'watch'"/>
      </conditions>
      <actions>
        <set_value name="$Seq" exact="@event.param3.{1}"/>
        <set_value name="$Max" exact="@event.param3.{2}"/>
        <do_if value="not $Max or $Max gt 12">
          <set_value name="$Max" exact="12"/>
        </do_if>

        <set_value name="$PSector" exact="'-'"/>
        <do_if value="@player.sector.exists">
          <set_value name="$PSector" exact="player.sector.macro.id"/>
        </do_if>
        <set_value name="$PShip" exact="'-'"/>
        <do_if value="@player.occupiedship.exists">
          <!-- M3-30: idcode, owner id, po + isplayerowned (0 or 1): does the ship the player flies belong to the player the way the engine counts it (Finding 4) -->
          <set_value name="$PShip" exact="player.occupiedship.idcode + '/' + @player.occupiedship.owner.id + '/po' + (if player.occupiedship.isplayerowned then 1 else 0)"/>
        </do_if>
        <set_value name="$Undisc" exact="'-'"/>
        <do_if value="@player.sector.exists and @player.occupiedship.exists">
          <find_closest_undiscovered_position result="$UndiscPos" sector="player.sector" range="2km">
            <position object="player.occupiedship"/>
            <rangecenter object="player.occupiedship"/>
          </find_closest_undiscovered_position>
          <do_if value="$UndiscPos?">
            <set_value name="$Undisc" exact="$UndiscPos.x + ':' + $UndiscPos.y + ':' + $UndiscPos.z"/>
          </do_if>
          <do_else>
            <set_value name="$Undisc" exact="'none'"/>
          </do_else>
        </do_if>

        <!-- team ships: the ones in the player's sector first, then the rest of the galaxy -->
        <set_value name="$Facs" exact="[faction.x4mp_team_1, faction.x4mp_team_2, faction.x4mp_team_3, faction.x4mp_team_4, faction.x4mp_team_5, faction.x4mp_team_6, faction.x4mp_team_7, faction.x4mp_team_8]"/>
        <set_value name="$Here" exact="[]"/>
        <set_value name="$There" exact="[]"/>
        <do_for_each name="$Fac" in="$Facs">
          <find_ship name="$Found" space="player.galaxy" owner="$Fac" multiple="true"/>
          <do_for_each name="$Ship" in="$Found">
            <do_if value="@$Ship.sector == @player.sector and @player.sector.exists">
              <append_to_list name="$Here" exact="$Ship"/>
            </do_if>
            <do_else>
              <append_to_list name="$There" exact="$Ship"/>
            </do_else>
          </do_for_each>
        </do_for_each>
        <set_value name="$Total" exact="$Here.count + $There.count"/>
        <set_value name="$Ordered" exact="[]"/>
        <do_for_each name="$Ship" in="$Here">
          <append_to_list name="$Ordered" exact="$Ship"/>
        </do_for_each>
        <do_for_each name="$Ship" in="$There">
          <append_to_list name="$Ordered" exact="$Ship"/>
        </do_for_each>

        <set_value name="$Out" exact="'W;' + $Seq + ';' + player.age + ';' + $PSector + ';' + $PShip + ';' + $Undisc + ';' + $Total"/>
        <set_value name="$N" exact="0"/>
        <do_for_each name="$Ship" in="$Ordered">
          <do_if value="$N lt $Max">
            <set_value name="$N" operation="add"/>
            <set_value name="$SecId" exact="'-'"/>
            <do_if value="@$Ship.sector.exists">
              <set_value name="$SecId" exact="$Ship.sector.macro.id"/>
            </do_if>
            <set_value name="$OwnId" exact="@$Ship.owner.id"/>
            <set_value name="$Out" exact="$Out + '|' + $Ship.idcode + ',' + $OwnId + ',' + $Ship.relationto.{faction.player} + ',' + (if $Ship.isradarvisible then 1 else 0) + ',' + (if $Ship.isinliveview then 1 else 0) + ',' + (if $Ship.isgravidarplayeraccessible then 1 else 0) + ',' + (if $Ship.isactive then 1 else 0) + ',' + (if $Ship.isknown then 1 else 0) + ',' + $SecId"/>
          </do_if>
        </do_for_each>
        <raise_lua_event name="'x4mp.md_knowledge'" param="$Out"/>
      </actions>
    </cue>

  </cues>
</mdscript>
