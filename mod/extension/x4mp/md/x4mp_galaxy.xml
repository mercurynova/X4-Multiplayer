<?xml version="1.0" encoding="utf-8"?>
<!--
  X4MP galaxy metadata for the authority, MD side (M2-09). Lua side: ui/x4mp_authority.lua; consumer: native features/authority.

  Lua -> MD  AddUITriggeredEvent("X4MP_Authority", "collect", "1")   the authority is about to answer a RequestSave: send the galaxy
  MD -> Lua  raise_lua_event 'x4mp.md_galaxy' <string>, forwarded unchanged to native (verb x4mp.auth_md). Messages:
               G;<sector>;<sector>;...   at most 40 sectors per message, each  macro|cluster_macro|name|owner_faction|x|y|z|gate,gate
               E;<count>                  all sectors were sent: <count> is the total
               P;macro|name|idcode|sector_macro|class|owner       the ship the player is in (absent when the player is on foot)
  Lua -> MD  AddUITriggeredEvent("X4MP_Authority", "ship", "1")      only the ship (close-out A item 3: player.occupiedship was still null
             at the first checkpoint, ~2 s after the universe was ready): answers with one P message, or "N;" when there is none
  Recipe: find_sector multiple (every normal sector of the galaxy), find_gate per sector with the gate's destination sector, as
  proven by the session-2 spike (S7). x/y/z are the cluster position (galaxy map); a field MD cannot answer is sent empty / 0.
  Names with '|' or ';' cannot be escaped in MD: native drops a record with the wrong field count.
-->
<mdscript name="X4MP_Galaxy" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>

    <cue name="X4MP_Galaxy_Collect" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'X4MP_Authority'" control="'collect'"/>
      </conditions>
      <actions>
        <find_sector name="$Sectors" multiple="true"/>
        <set_value name="$Chunk" exact="''"/>
        <set_value name="$InChunk" exact="0"/>
        <do_for_each name="$Sec" in="$Sectors">
          <set_value name="$Gates" exact="''"/>
          <find_gate name="$GateObjs" space="$Sec" multiple="true"/>
          <do_for_each name="$Gate" in="$GateObjs">
            <set_value name="$Dest" exact="@$Gate.destination.sector.macro.id"/>
            <do_if value="$Dest != null">
              <do_if value="$Gates != ''">
                <set_value name="$Gates" exact="$Gates + ','"/>
              </do_if>
              <set_value name="$Gates" exact="$Gates + $Dest"/>
            </do_if>
          </do_for_each>
          <set_value name="$Owner" exact="@$Sec.owner.id"/>
          <do_if value="$Owner == null">
            <set_value name="$Owner" exact="''"/>
          </do_if>
          <set_value name="$SecName" exact="@$Sec.name"/>
          <do_if value="$SecName == null">
            <set_value name="$SecName" exact="''"/>
          </do_if>
          <set_value name="$ClusterId" exact="@$Sec.cluster.macro.id"/>
          <do_if value="$ClusterId == null">
            <set_value name="$ClusterId" exact="''"/>
          </do_if>
          <set_value name="$PosX" exact="@$Sec.cluster.position.x"/>
          <set_value name="$PosY" exact="@$Sec.cluster.position.y"/>
          <set_value name="$PosZ" exact="@$Sec.cluster.position.z"/>
          <do_if value="$PosX == null">
            <set_value name="$PosX" exact="0"/>
          </do_if>
          <do_if value="$PosY == null">
            <set_value name="$PosY" exact="0"/>
          </do_if>
          <do_if value="$PosZ == null">
            <set_value name="$PosZ" exact="0"/>
          </do_if>
          <do_if value="$Chunk != ''">
            <set_value name="$Chunk" exact="$Chunk + ';'"/>
          </do_if>
          <set_value name="$Chunk" exact="$Chunk + $Sec.macro.id + '|' + $ClusterId + '|' + $SecName + '|' + $Owner + '|' + $PosX + '|' + $PosY + '|' + $PosZ + '|' + $Gates"/>
          <set_value name="$InChunk" exact="$InChunk + 1"/>
          <do_if value="$InChunk ge 40">
            <raise_lua_event name="'x4mp.md_galaxy'" param="'G;' + $Chunk"/>
            <set_value name="$Chunk" exact="''"/>
            <set_value name="$InChunk" exact="0"/>
          </do_if>
        </do_for_each>
        <do_if value="$Chunk != ''">
          <raise_lua_event name="'x4mp.md_galaxy'" param="'G;' + $Chunk"/>
        </do_if>
        <raise_lua_event name="'x4mp.md_galaxy'" param="'E;' + $Sectors.count"/>

        <!-- the player's ship: occupied ship first (on foot: none) -->
        <set_value name="$Ship" exact="player.occupiedship"/>
        <do_if value="$Ship and $Ship.exists">
          <set_value name="$Cls" exact="''"/>
          <do_if value="$Ship.isclass.ship_xs">
            <set_value name="$Cls" exact="'ship_xs'"/>
          </do_if>
          <do_elseif value="$Ship.isclass.ship_s">
            <set_value name="$Cls" exact="'ship_s'"/>
          </do_elseif>
          <do_elseif value="$Ship.isclass.ship_m">
            <set_value name="$Cls" exact="'ship_m'"/>
          </do_elseif>
          <do_elseif value="$Ship.isclass.ship_l">
            <set_value name="$Cls" exact="'ship_l'"/>
          </do_elseif>
          <do_elseif value="$Ship.isclass.ship_xl">
            <set_value name="$Cls" exact="'ship_xl'"/>
          </do_elseif>
          <set_value name="$ShipSector" exact="@$Ship.sector.macro.id"/>
          <do_if value="$ShipSector == null">
            <set_value name="$ShipSector" exact="''"/>
          </do_if>
          <set_value name="$ShipName" exact="@$Ship.name"/>
          <do_if value="$ShipName == null">
            <set_value name="$ShipName" exact="''"/>
          </do_if>
          <set_value name="$ShipCode" exact="@$Ship.idcode"/>
          <do_if value="$ShipCode == null">
            <set_value name="$ShipCode" exact="''"/>
          </do_if>
          <set_value name="$ShipOwner" exact="@$Ship.owner.id"/>
          <do_if value="$ShipOwner == null">
            <set_value name="$ShipOwner" exact="'player'"/>
          </do_if>
          <raise_lua_event name="'x4mp.md_galaxy'" param="'P;' + $Ship.macro.id + '|' + $ShipName + '|' + $ShipCode + '|' + $ShipSector + '|' + $Cls + '|' + $ShipOwner"/>
        </do_if>
      </actions>
    </cue>

    <cue name="X4MP_Galaxy_Ship" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'X4MP_Authority'" control="'ship'"/>
      </conditions>
      <actions>
        <!-- the player's ship: occupied ship first (on foot: none) -->
        <set_value name="$Ship" exact="player.occupiedship"/>
        <do_if value="$Ship and $Ship.exists">
          <set_value name="$Cls" exact="''"/>
          <do_if value="$Ship.isclass.ship_xs">
            <set_value name="$Cls" exact="'ship_xs'"/>
          </do_if>
          <do_elseif value="$Ship.isclass.ship_s">
            <set_value name="$Cls" exact="'ship_s'"/>
          </do_elseif>
          <do_elseif value="$Ship.isclass.ship_m">
            <set_value name="$Cls" exact="'ship_m'"/>
          </do_elseif>
          <do_elseif value="$Ship.isclass.ship_l">
            <set_value name="$Cls" exact="'ship_l'"/>
          </do_elseif>
          <do_elseif value="$Ship.isclass.ship_xl">
            <set_value name="$Cls" exact="'ship_xl'"/>
          </do_elseif>
          <set_value name="$ShipSector" exact="@$Ship.sector.macro.id"/>
          <do_if value="$ShipSector == null">
            <set_value name="$ShipSector" exact="''"/>
          </do_if>
          <set_value name="$ShipName" exact="@$Ship.name"/>
          <do_if value="$ShipName == null">
            <set_value name="$ShipName" exact="''"/>
          </do_if>
          <set_value name="$ShipCode" exact="@$Ship.idcode"/>
          <do_if value="$ShipCode == null">
            <set_value name="$ShipCode" exact="''"/>
          </do_if>
          <set_value name="$ShipOwner" exact="@$Ship.owner.id"/>
          <do_if value="$ShipOwner == null">
            <set_value name="$ShipOwner" exact="'player'"/>
          </do_if>
          <raise_lua_event name="'x4mp.md_galaxy'" param="'P;' + $Ship.macro.id + '|' + $ShipName + '|' + $ShipCode + '|' + $ShipSector + '|' + $Cls + '|' + $ShipOwner"/>
        </do_if>
        <do_if value="not ($Ship and $Ship.exists)">
          <raise_lua_event name="'x4mp.md_galaxy'" param="'N;'"/>
        </do_if>
      </actions>
    </cue>

    <!-- ===================================== M3-09: sector map (every node) =====================================
         Lua -> MD  AddUITriggeredEvent("X4MP_Authority", "map", "1"): every sector of the galaxy as a (macro, component) pair, so native can map
         the game's sector UniverseID <-> macro <-> the wire's sector index (features/selfship/galaxy_map.h).
         MD -> Lua  'x4mp.md_sector_tag' (param = the sector macro id) immediately followed by 'x4mp.md_sector' (param = the sector; Lua converts it
                    with ConvertStringTo64Bit as the session-4 spike S13.7 did for ships), then 'x4mp.md_sector_end' (param = the count). -->
    <cue name="X4MP_Galaxy_Map" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'X4MP_Authority'" control="'map'"/>
      </conditions>
      <actions>
        <find_sector name="$MapSectors" multiple="true"/>
        <do_for_each name="$MapSec" in="$MapSectors">
          <raise_lua_event name="'x4mp.md_sector_tag'" param="$MapSec.macro.id"/>
          <raise_lua_event name="'x4mp.md_sector'" param="$MapSec"/>
        </do_for_each>
        <raise_lua_event name="'x4mp.md_sector_end'" param="$MapSectors.count"/>
      </actions>
    </cue>

    <!-- ===================================== M3-09: SETA is unavailable in multiplayer =====================================
         Lua -> MD  AddUITriggeredEvent("X4MP_Authority", "seta_block", "1"|"0")  while connected: block SETA at the source
                    AddUITriggeredEvent("X4MP_Authority", "seta_off", "1")        native saw IsSetaActive: switch it off now
         MD -> Lua  'x4mp.md_seta' ('blocked')  MD stopped a SETA start itself (native shows "SETA is disabled in multiplayer")
         Source of the SETA start: md/modes.xml Mode_SETA listens to the signal (player.entity, 'startactivity', activity.seta); the
         input action calls StartPlayerActivity("seta") (menu_map.lua) and the engine key INPUT_ACTION_TOGGLE_SETA_MODE feeds the same
         signal. Our guard listens to the same signal and stops the activity again: signal 'stopactivity' (what md/modes.xml Phase4 does for
         the tea easter egg), then toggle_timewarp / set_timewarp_factor only while player.timewarp.active (session-4 spike S13.9 recipe). -->
    <cue name="X4MP_Seta_Flag" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'X4MP_Authority'" control="'seta_block'"/>
      </conditions>
      <actions>
        <set_value name="md.$X4MP_SetaBlock" exact="if event.param3 == '1' then 1 else 0"/>
      </actions>
    </cue>

    <cue name="X4MP_Seta_Reset" instantiate="true">
      <conditions>
        <check_any>
          <event_game_loaded/>
          <event_game_started/>
        </check_any>
      </conditions>
      <actions>
        <!-- the flag is saved with the game: a loaded game is not connected until native says so again -->
        <set_value name="md.$X4MP_SetaBlock" exact="0"/>
      </actions>
    </cue>

    <cue name="X4MP_Seta_Guard" instantiate="true">
      <conditions>
        <event_object_signalled object="player.entity" param="'startactivity'" param2="activity.seta"/>
      </conditions>
      <actions>
        <do_if value="@md.$X4MP_SetaBlock">
          <signal_objects object="player.entity" param="'stopactivity'" param2="activity.seta" param3="false"/>
          <raise_lua_event name="'x4mp.md_seta'" param="'blocked'"/>
        </do_if>
      </actions>
      <cues>
        <cue name="X4MP_Seta_Guard_Check">
          <!-- the stopactivity signal above should have ended it; if SETA is still on after 200 ms, toggle it off (spike S13.9) -->
          <delay exact="200ms"/>
          <actions>
            <do_if value="@md.$X4MP_SetaBlock and player.timewarp.active">
              <toggle_timewarp/>
            </do_if>
          </actions>
        </cue>
      </cues>
    </cue>

    <cue name="X4MP_Seta_Off" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'X4MP_Authority'" control="'seta_off'"/>
      </conditions>
      <actions>
        <do_if value="player.timewarp.active">
          <signal_objects object="player.entity" param="'stopactivity'" param2="activity.seta" param3="false"/>
        </do_if>
      </actions>
      <cues>
        <cue name="X4MP_Seta_Off_Toggle">
          <delay exact="300ms"/>
          <actions>
            <do_if value="player.timewarp.active">
              <toggle_timewarp/>
            </do_if>
          </actions>
          <cues>
            <cue name="X4MP_Seta_Off_Factor">
              <delay exact="300ms"/>
              <actions>
                <do_if value="player.timewarp.active">
                  <set_timewarp_factor/>
                </do_if>
              </actions>
            </cue>
          </cues>
        </cue>
      </cues>
    </cue>

    <!-- ===================================== M3-33: the game's superhighway signal (Finding 21) =====================================
         Speed is NOT a signal (many ships exceed 3.5 km/s in normal travel); these are the game's own events for the PLAYER, raised as ONE string
         each (raise_lua_event never carries a list):
         MD -> Lua  'x4mp.md_highway' <source>   (Lua forwards it to native as x4mp.highway_signal {"source": <source>})
           'gate'    event_player_entered_gate: the entry gate is a highway entry gate whose highway is a superhighway (fires when the ship
                     flies into the entry ring; vanilla uses this event for jump gates, whether it fires for highway gates is UNVERIFIED)
           'zone'    event_object_changed_zone (player.entity): the new zone is a superhighway (vanilla md/scenario_tutorials.xml Tutorial_SuperHighway_Done
                     uses exactly this test; md/guidance.xml ChangedSpace logged "Player has entered: Superhighway" in the session-4 two-PC run)
           'sector'  event_object_changed_sector (player.entity) with a null new sector (the common.xsd doc: "sector can be null in case of a superhighway")
           'exit'    event_object_changed_zone: the previous zone was a superhighway and the new one is not
         Native logs which one came first ("selfship: superhighway entry signalled by <source> at sector N") and how the others followed. -->
    <cue name="X4MP_Highway_Gate" instantiate="true">
      <conditions>
        <event_player_entered_gate/>
      </conditions>
      <actions>
        <do_if value="@event.param.isclass.highwayentrygate">
          <do_if value="@event.param.highway.issuperhighway">
            <raise_lua_event name="'x4mp.md_highway'" param="'gate'"/>
          </do_if>
        </do_if>
      </actions>
    </cue>

    <cue name="X4MP_Highway_Zone" instantiate="true">
      <conditions>
        <event_object_changed_zone object="player.entity"/>
      </conditions>
      <actions>
        <do_if value="@event.param.issuperhighway">
          <raise_lua_event name="'x4mp.md_highway'" param="'zone'"/>
        </do_if>
        <do_elseif value="@event.param2.issuperhighway">
          <raise_lua_event name="'x4mp.md_highway'" param="'exit'"/>
        </do_elseif>
      </actions>
    </cue>

    <cue name="X4MP_Highway_Sector" instantiate="true">
      <conditions>
        <event_object_changed_sector object="player.entity"/>
      </conditions>
      <actions>
        <do_if value="not event.param.exists">
          <raise_lua_event name="'x4mp.md_highway'" param="'sector'"/>
        </do_if>
      </actions>
    </cue>

  </cues>
</mdscript>
