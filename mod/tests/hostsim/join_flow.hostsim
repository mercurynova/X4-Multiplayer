# M2-06 acceptance: join -> download -> loadSave -> (X4 reloads the DLL) -> resume -> universe ready -> NodeReady -> the server shows
# the player InGame. Run by mod/tests/hostsim/join_flow_run.ps1 (needs the server + a FakeNode authority; vars: tcp, save_sha).
# F1: the main-menu leave is confirmed after 2 s here (default 30 s)
write-file extension/x4mp.json {"menu_leave_confirm_ms":2000}
init
frame 60Hz 10
lua-raw x4mp.ui_ready {"v":1,"startmenu":true}
lua-raw x4mp.join {"v":1,"address":"127.0.0.1:${tcp}","name":"Alice","password":"","team":"auto"}
frame 60Hz 360
expect-lua x4mp.status 1000 json $.state == connecting
expect-lua x4mp.load_save 3000 contains x4mp_
expect-lua loadSave 3000 contains x4mp_
exec cmd /c dir /b "${save_dir}\*.xml.gz"
expect-stash join.state present
expect-lua x4mp.status 3000 json $.state == loading

# X4 now unloads and re-initialises the DLL (stash kept): the session resumes, the player is still not InGame
reload
expect-state reloads == 1
frame 60Hz 240
expect-file extension/logs/x4mp.log resuming the session after an extension reload
expect-lua x4mp.status 3000 json $.state == loading

# the universe becomes ready (on_game_loaded + on_universe_ready): LoadStatus Matching, ManifestReport, NodeReady
load_save x4mp_join_e2e
frame 60Hz 180
expect-file extension/logs/x4mp.log NodeReady sent
expect-lua x4mp.status 3000 json $.state == ingame
expect-admin /api/v1/players $[name==Alice].online == true
expect-admin /api/v1/players $[name==Alice].id exists

# M3-08: the team factions. At universe ready the mod sends the plan of the session (one team = slot 1, own team +1.0 for player) to Lua as
# x4mp.teams_apply; the MD answer is simulated (no MD in hostsim) with the verb x4mp.teams_md; the report turns the state to ok and the self-test
# line team.factions passes. A stale report (old seq) is ignored.
expect-lua x4mp.teams_apply 3000 contains [[0,1,0.99]]
expect-file extension/logs/x4mp.log teams: apply seq=1 reason=universe_ready slots=[1] relations=1 own_slot=1
lua-raw x4mp.teams_md {"v":1,"data":"R;9;1;0;0;1;1"}
lua-raw x4mp.teams_md {"v":1,"data":"R;1;1;0;0;1;1"}
frame 60Hz 10
expect-file extension/logs/x4mp.log teams: MD report 'R;1;1;0;0;1;1' -> ok
lua-raw x4mp.selftest {"v":1}
frame 60Hz 10
expect-file extension/logs/x4mp.log SELFTEST PASS  team.factions

# M3-06: the player table (authority + Alice) and a chat round trip through the real server: the sender gets its own line back
# (all and team), the line reaches Lua as x4mp.chat with the author and the sender flag, and the text never lands in the mod log at Info.
expect-lua x4mp.players 3000 json $.players[name==Alice].online == true
expect-lua x4mp.players 3000 json $.players.length >= 2
lua-raw x4mp.chat_send {"v":1,"channel":"all","text":"hello from hostsim"}
frame 60Hz 120
expect-lua x4mp.chat 3000 json $.messages[0].name == Alice
lua-raw x4mp.chat_send {"v":1,"channel":"team","text":"team line from hostsim"}
frame 60Hz 120
expect-lua x4mp.chat 3000 contains team line from hostsim
lua-raw x4mp.chat_send {"v":1,"channel":"whisper","to":999,"text":"whisper to nobody"}
frame 60Hz 120
expect-lua x4mp.chat 3000 contains not online
expect-file extension/logs/x4mp.log chat: sent channel=all
# a fresh Lua state (/reloadui) announces itself with ui_ready: the recent chat history and the player table come again
drop-lua x4mp.players
lua-raw x4mp.ui_ready {"v":1,"startmenu":false}
frame 60Hz 60
expect-lua x4mp.chat 3000 json $.replay == true
expect-lua x4mp.players 3000 json $.players[name==Alice].online == true

# F1 (ADR-052): exit to the main menu counts as leaving. X4 unloads the extension (the same shutdown as a /reloadui or a save load, stash kept);
# the new incarnation resumes the session. What differs is the Lua state: the start menu (ui_ready startmenu=true) and no game ever loads.
# (a) negative: a start-menu ui_ready that is followed by a game (here: startmenu=false, as after /reloadui) must NOT leave
reload
frame 60Hz 20
lua-raw x4mp.ui_ready {"v":1,"startmenu":true}
frame 60Hz 30
lua-raw x4mp.ui_ready {"v":1,"startmenu":false}
frame 60Hz 240
expect-file extension/logs/x4mp.log main menu: no longer the start menu
expect-no-log leaving the session (F1)
expect-admin /api/v1/players $[name==Alice].online == true
# (a2) negative: the start menu is reported but the game then loads (a save load) inside the delay: on_game_loaded disarms the watch
reload
frame 60Hz 20
lua-raw x4mp.ui_ready {"v":1,"startmenu":true}
frame 60Hz 30
set game_time 900000
load_save x4mp_join_e2e
frame 60Hz 300
expect-no-log leaving the session (F1)
expect-lua x4mp.status 3000 json $.state == ingame
expect-admin /api/v1/players $[name==Alice].online == true
# (b) positive: the start menu stays up with no game loading -> after the delay the mod leaves like the Disconnect button
reload
frame 60Hz 20
lua-raw x4mp.ui_ready {"v":1,"startmenu":true}
frame 60Hz 240
expect-file extension/logs/x4mp.log main menu: the player exited to the main menu; leaving the session (F1)
expect-file extension/logs/x4mp.log leaving the session (main menu)
expect-lua x4mp.status 3000 json $.state == disconnected
expect-admin /api/v1/players $[name==Alice].online == false
expect-stash join.state absent
# (c) loading back into the session is a normal rejoin
drop-lua
lua-raw x4mp.join {"v":1,"address":"127.0.0.1:${tcp}","name":"Alice","password":"","team":"auto"}
frame 60Hz 360
expect-lua x4mp.load_save 3000 contains x4mp_
reload
frame 60Hz 240
load_save x4mp_join_e2e
frame 60Hz 180
expect-lua x4mp.status 3000 json $.state == ingame
expect-admin /api/v1/players $[name==Alice].online == true

lua-raw x4mp.disconnect {"v":1}
frame 60Hz 60
expect-no-secret never-written-password
shutdown
