# M3-04 pair scenario: one of TWO hostsim processes (two real x4mp.dll instances) that share one server. Run by pair_run.ps1.
# vars: tcp, name (this player), other (the other player), sync (a folder both processes can write).
# Trivial on purpose (the DLL has no M3 features yet): join, resume after the reload, InGame, see each other online, sit in the
# seat and fly a circle in the fake universe, then leave only after the other player also got this far. Wave-2 tasks (M3-09/10/11)
# copy this file and add `expect-object` / `expect-ghost` lines.
init
frame 60Hz 10
lua-raw x4mp.ui_ready {"v":1,"startmenu":true}
lua-raw x4mp.join {"v":1,"address":"127.0.0.1:${tcp}","name":"${name}","password":"","team":"auto"}
frame 60Hz 360
expect-lua x4mp.load_save 5000 contains x4mp_

# X4 reloads the DLL (stash kept): the session resumes
reload
frame 60Hz 240
expect-file extension/logs/x4mp.log resuming the session after an extension reload

load_save x4mp_pair_e2e
frame 60Hz 180
expect-lua x4mp.status 5000 json $.state == ingame
expect-admin /api/v1/players $[name==${name}].online == true

# ---- M3-09 own ship (features/selfship): every process has its own fake universe; the server sees the PlayerState stream ----
# the mod asks MD for the sector map at universe ready; this script plays MD/Lua (macros sort to cluster_01 = index 1, cluster_02 = 2)
expect-lua x4mp.sector_map_collect 5000
lua-raw x4mp.sector_map {"v":1,"data":"S;cluster_02_sector001_macro|100002;cluster_01_sector001_macro|100001"}
lua-raw x4mp.sector_map {"v":1,"data":"E;2"}
expect-lua x4mp.seta_block 5000 json $.on == true
# seat off: the ship is known from the container, but no state goes out
frame 60Hz 150
expect-file extension/logs/x4mp.log selfship: sector map ready: 2 sectors
expect-lua x4mp.selfship 3000 json $.map_ready == true
expect-lua x4mp.selfship 3000 json $.sent == 0
# sit down and fly a circle: 20 Hz, the first state is immediate (sit-down), the server learns the sector
drop-lua x4mp.selfship
ship place sector=100001 pos=0,0,0
ship path circle radius=2000 speed=250 center=0,0,0 sector=100001
seat on
frame 60Hz 240
expect-file extension/logs/x4mp.log selfship: the player sat down
expect-lua x4mp.selfship 3000 json $.seated == true
expect-lua x4mp.selfship 3000 json $.rate_hz > 17
expect-lua x4mp.selfship 3000 json $.rate_hz < 23
expect-admin /api/v1/dashboard $.players[name==${name}].sectorId == 1 timeout=5000
# idle: 5 Hz
ship path stop
frame 60Hz 90
drop-lua x4mp.selfship
frame 60Hz 180
expect-lua x4mp.selfship 3000 json $.rate_hz > 3.5
expect-lua x4mp.selfship 3000 json $.rate_hz < 6.5
# a gate jump: immediate state with Teleport, the server follows into sector 2
drop-lua x4mp.selfship
ship path gate from=0,0,-500 to=0,0,0 speed=500 sector=100001 to_sector=100002 exit=0,0,50
frame 60Hz 120
expect-state gate_jumps == 1
expect-lua x4mp.selfship 3000 json $.teleports >= 1
expect-admin /api/v1/dashboard $.players[name==${name}].sectorId == 2 timeout=5000
# docked: Hidden, 1 Hz
drop-lua x4mp.selfship
dock
frame 60Hz 60
drop-lua x4mp.selfship
frame 60Hz 240
expect-lua x4mp.selfship 3000 json $.hidden == true
expect-lua x4mp.selfship 3000 json $.rate_hz < 2
undock
frame 60Hz 90
# a highway: Hidden too
highway on
frame 60Hz 30
drop-lua x4mp.selfship
frame 60Hz 90
expect-lua x4mp.selfship 3000 json $.hidden == true
highway off
frame 60Hz 90
# SETA: switched off within 1 s of being detected, with the notification
drop-lua x4mp.seta_off
seta on
frame 60Hz 20
expect-lua x4mp.seta_off 1000
expect-lua x4mp.notify 1000 contains SETA is disabled in multiplayer
seta off
frame 60Hz 20
expect-file extension/logs/x4mp.log selfship: SETA is off again after
# stand up: one Hidden state, then nothing
seat off
frame 60Hz 90
drop-lua x4mp.selfship
frame 60Hz 180
expect-lua x4mp.selfship 3000 json $.seated == false
expect-lua x4mp.selfship 3000 json $.rate_hz == 0
expect-file extension/logs/x4mp.log selfship: the player stood up
ship path stop

# fake universe: sit down, fly a circle for 2 s of game time
seat on
ship path circle radius=2000 speed=250 center=0,0,0 sector=100001
frame 60Hz 120
expect-object player sector == 100001
expect-state seat == 1
expect-state path_active == 1

# both players in game at the same time
expect-admin /api/v1/players $[name==${other}].online == true timeout=30000
write-file ${sync}/${name}.done ok
expect-file ${sync}/${other}.done ok

expect-no-secret never-written-password
shutdown
