<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- dotnet publish server/src/X4MP.Server -c Release -p:PublishProfile=linux-x64
       Single-file, self-contained, compressed; the same properties as the
       RuntimeIdentifier condition in X4MP.Server.csproj (profiles are imported after it is evaluated). -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\..\out\linux-x64\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>
