<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- The bundle the game runs: a folder of files, not a single-file exe.
       dotnet publish server/src/X4MP.Server -c Release -p:PublishProfile=win-x64-bundle

       These are the flags of the bundle that has actually been started from the game's menu and
       played on: mod/tools/deploy.ps1 -WithServer passes the same ones, and PublishDir is the same
       folder that script uses, so a release artifact and a dev artifact are one artifact.
       - PublishSingleFile=false: inside X4 the single-file form is the one that failed. The
         standalone zip (win-x64.pubxml) still ships as one exe and runs from a normal shell —
         `x4mp-server version` answers — but only the folder form has been proven in the game.
       - PublishReadyToRun=false: a ReadyToRun image fail-fasts inside X4 with 0xC0000602 before
         the process can print a line.
       The web GUI is built (no SkipWebBuild), because this is the copy a player downloads. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\..\out\server-win-x64\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
