<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The server publishes for win-x64 and linux-x64, and the RID propagates to every project it
    references, so a publish writes RID sections into this lock file. Declared here as well, so a
    plain restore and the locked restore in CI expect exactly those sections.
  -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel's ConnectionHandler / ConnectionContext live in the ASP.NET Core shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\X4MP.Core\X4MP.Core.csproj" />
    <ProjectReference Include="..\X4MP.Protocol\X4MP.Protocol.csproj" />
  </ItemGroup>

</Project>
