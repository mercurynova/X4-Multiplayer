<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Google.FlatBuffers" />
  </ItemGroup>

  <!--
    FlatBuffers codegen (M0-04). Runs the pinned flatc (tools/flatc, fetched by fetch-flatc.ps1/.sh) over
    protocol/schema/*.fbs and compiles the generated C# (namespace X4MP.Proto) from obj/.
    Generated files are marked <auto-generated>, so analyzers skip them and nullable is off for them;
    warnings are never suppressed globally.
  -->
  <PropertyGroup>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', '..'))</RepoRoot>
    <SchemaDir>$(RepoRoot)protocol/schema/</SchemaDir>
    <FlatcExe Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(RepoRoot)tools/flatc/bin/flatc.exe</FlatcExe>
    <FlatcExe Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(RepoRoot)tools/flatc/bin/flatc</FlatcExe>
    <FlatcOutDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)flatc/</FlatcOutDir>
    <FlatcStamp>$(FlatcOutDir).stamp</FlatcStamp>
  </PropertyGroup>

  <ItemGroup>
    <FlatcSchema Include="$(SchemaDir)*.fbs" />
  </ItemGroup>

  <Target Name="GenerateFlatBuffers" BeforeTargets="CoreCompile;CoreGenerateAssemblyInfo" Inputs="@(FlatcSchema);$(FlatcExe);$(RepoRoot)tools/flatc/flatc.lock.json" Outputs="$(FlatcStamp)">
    <Error Condition="!Exists('$(FlatcExe)')" Code="X4MP001"
           Text="flatc not found at '$(FlatcExe)'. Run 'pwsh tools/flatc/fetch-flatc.ps1' (Windows) or 'tools/flatc/fetch-flatc.sh' (Linux) once, then build again." />
    <RemoveDir Directories="$(FlatcOutDir)" />
    <MakeDir Directories="$(FlatcOutDir)" />
    <Exec Command="&quot;$(FlatcExe)&quot; --csharp --gen-object-api -o &quot;$(FlatcOutDir.TrimEnd('/'))&quot; -I &quot;$(SchemaDir.TrimEnd('/'))&quot; @(FlatcSchema->'&quot;%(FullPath)&quot;', ' ')" />
    <Touch Files="$(FlatcStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="IncludeFlatBuffersGenerated" AfterTargets="GenerateFlatBuffers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Include="$(FlatcOutDir)**/*.cs" />
    </ItemGroup>
  </Target>

</Project>
